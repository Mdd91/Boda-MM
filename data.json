tulo": "Culturales", "icono": "cultura", "items": [{"nombre": "Basílica de San Marco y Palacio Ducal", "zona": "San Marco", "detalle": "El corazón de Venecia. Compra entradas con hora en línea; en enero hay menos fila temprano.", "mapa": "https://www.google.com/maps/search/?api=1&query=Basilica%20di%20San%20Marco%2C%20Venezia"}, {"nombre": "Gallerie dell'Accademia", "zona": "Dorsoduro", "detalle": "La gran pinacoteca veneciana: Tiziano, Tintoretto, Bellini, Veronese.", "mapa": "https://www.google.com/maps/search/?api=1&query=Gallerie%20dell%27Accademia%2C%20Venezia"}, {"nombre": "Colección Peggy Guggenheim", "zona": "Dorsoduro", "detalle": "Arte moderno en un palacio sobre el Gran Canal. Cierra los martes.", "mapa": "https://www.google.com/maps/search/?api=1&query=Peggy%20Guggenheim%20Collection%2C%20Venezia"}, {"nombre": "Scuola Grande di San Rocco", "zona": "San Polo", "detalle": "Salas enteras pintadas por Tintoretto; una joya poco concurrida.", "mapa": "https://www.google.com/maps/search/?api=1&query=Scuola%20Grande%20di%20San%20Rocco%2C%20Venezia"}, {"nombre": "Teatro La Fenice", "zona": "San Marco", "detalle": "Ópera o concierto en el teatro más bello de Italia; también hay visitas guiadas de día.", "mapa": "https://www.google.com/maps/search/?api=1&query=Teatro%20La%20Fenice%2C%20Venezia"}, {"nombre": "Gueto judío", "zona": "Cannaregio", "detalle": "El primer gueto del mundo, a pocos minutos de Ca' Sagredo. Sinagogas y museo.", "mapa": "https://www.google.com/maps/search/?api=1&query=Ghetto%20Ebraico%20Venezia%2C%20Venezia"}, {"nombre": "Mercado de Rialto", "zona": "San Polo", "detalle": "Pescado y verduras en la mañana (martes a sábado). Ideal antes de un cicchetto.", "mapa": "https://www.google.com/maps/search/?api=1&query=Mercato%20di%20Rialto%2C%20Venezia"}, {"nombre": "Murano y Burano", "zona": "Laguna", "detalle": "Vidrio soplado y casitas de colores. Vaporetto desde Fondamente Nove, cerca de los Miracoli.", "mapa": "https://www.google.com/maps/search/?api=1&query=Fondamente%20Nove%2C%20Venezia"}]}, {"id": "restaurantes", "titulo": "Restaurantes", "icono": "restaurantes", "items": [{"nombre": "Vini da Gigio", "zona": "Cannaregio", "detalle": "Cocina veneciana clásica y gran carta de vinos, cerca de Ca' Sagredo. Reservar.", "mapa": "https://www.google.com/maps/search/?api=1&query=Vini%20da%20Gigio%2C%20Venezia"}, {"nombre": "Osteria Bentigodi", "zona": "Cannaregio", "detalle": "Osteria familiar con platos de la laguna; ambiente relajado.", "mapa": "https://www.google.com/maps/search/?api=1&query=Osteria%20Bentigodi%2C%20Venezia"}, {"nombre": "Antiche Carampane", "zona": "San Polo", "detalle": "Pescado y mariscos, escondida cerca de Rialto. Reservar con tiempo.", "mapa": "https://www.google.com/maps/search/?api=1&query=Trattoria%20Antiche%20Carampane%2C%20Venezia"}, {"nombre": "Osteria alle Testiere", "zona": "Castello", "detalle": "Pequeñísima y muy buscada; pescado del día.", "mapa": "https://www.google.com/maps/search/?api=1&query=Osteria%20alle%20Testiere%2C%20Venezia"}, {"nombre": "Cantina Do Mori", "zona": "San Polo", "detalle": "Bacaro histórico para cicchetti y una ombra de vino de pie.", "mapa": "https://www.google.com/maps/search/?api=1&query=Cantina%20Do%20Mori%2C%20Venezia"}, {"nombre": "Al Timon", "zona": "Cannaregio", "detalle": "Cicchetti y vino en la Fondamenta degli Ormesini, con una barca como terraza.", "mapa": "https://www.google.com/maps/search/?api=1&query=Al%20Timon%2C%20Venezia"}, {"nombre": "Harry's Bar", "zona": "San Marco", "detalle": "Donde nació el Bellini y el carpaccio. Clásico para un brindis.", "mapa": "https://www.google.com/maps/search/?api=1&query=Harry%27s%20Bar%2C%20Venezia"}, {"nombre": "Caffè Florian", "zona": "Plaza San Marco", "detalle": "Café desde 1720; un chocolate caliente en enero es obligado.", "mapa": "https://www.google.com/maps/search/?api=1&query=Caff%C3%A8%20Florian%2C%20Venezia"}]}, {"id": "hoteles", "titulo": "Hoteles", "icono": "hoteles", "items": [{"nombre": "